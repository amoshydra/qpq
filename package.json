{
  "name": "qpq",
  "version": "0.3.0",
  "description": "A native TUI launcher for frequently used commands",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amoshydra/qpq.git"
  },
  "homepage": "https://github.com/amoshydra/qpq",
  "type": "module",
  "bin": {
    "qpq": "./qpq.sh"
  },
  "scripts": {
    "test": "node --test",
    "prepare": "husky",
    "prepare:npm": "node scripts/publish-npm.mjs --prepare-only",
    "publish:npm": "node scripts/publish-npm.mjs",
    "bootstrap:platforms": "node scripts/publish-npm.mjs --bootstrap",
    "lint:package": "publint"
  },
  "keywords": [
    "qpq",
    "launcher",
    "cli",
    "tui"
  ],
  "author": "",
  "files": [
    "qpq.sh"
  ],
  "license": "MIT",
  "os": [
    "linux",
    "darwin",
    "android"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "publint": "^0.3.25"
  }
}
